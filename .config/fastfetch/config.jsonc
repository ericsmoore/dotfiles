{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1
    },
    "position": "right",
    "color": {
      "1": "38;2;177;66;66", 
    },
  },
  "display": {
    "color": {
      "title": "38;2;177;66;66",
      "keys": "dim_white",
    },
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "shell",
    "wm",
    "terminal",
    "separator",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "separator",
    "datetime",
    {
      "type": "battery",
      "format": "{capacity} [{status}]",
    },
    "wifi",
    "bluetooth",
    "separator",
  ]
}
